o# ── Granova Backend · variables de entorno ─────────────────────
# Copia este archivo como ".env" o configura estas variables en el
# panel de Railway. Todo es obligatorio en producción.

# Puerto del servidor (lo define Railway automáticamente).
PORT=3000

# URL pública del frontend. Los correos (verificación, reset de clave,
# etc.) usan este dominio para armar sus enlaces.
FRONTEND_URL=https://www.granovaoficial.com

# Conexión a Supabase (PostgreSQL).
DATABASE_URL=postgresql://usuario:clave@host:5432/granova

# Clave secreta del backend (JWT). CAMBIAR en producción.
# El backend lee exactamente esta variable: JWT_SECRET.
JWT_SECRET=pon-una-clave-larga-y-secreta

# ── Correo (Brevo) ─────────────────────────────────────────────
# API key de Brevo y correo remitente verificado en Brevo.
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_API_KEY=cambia-por-tu-api-key-de-brevo
EMAIL_USER=correo-verificado@tu-dominio.com

# ── Asistente (n8n) ────────────────────────────────────────────
# Webhooks del asistente del panel y del cliente.
N8N_WEBHOOK_URL=https://n8n-production-aacb.up.railway.app/webhook/granova-chat
N8N_WEBHOOK_URL_CLIENTE=https://n8n-production-aacb.up.railway.app/webhook/Chat-Cliente

# ── Pagos (Wompi) ──────────────────────────────────────────────
# Pasarela activa: 'simulador' (demo SENA) o 'wompi' (pago real, TEST).
PASARELA=simulador

# Llaves Wompi en modo TEST (sandbox). En producción se cambia la URL.
WOMPI_PUBLIC_KEY=pub_test_xxxx
WOMPI_PRIVATE_KEY=sk_test_xxxx
WOMPI_INTEGRITY_SECRET=xxxxxxxx (se genera desde el dashboard de Wompi)
WOMPI_EVENTS_SECRET=xxxxxxxx (clave del evento transaction.updated en sandbox)
WOMPI_BASE_URL=https://sandbox.wompi.co/v1

# ── Cloudflare Turnstile (anti-bot en el registro) ──────────────
# La SECRET Key la obtienes en Dash Cloudflare → Turnstile → Manage
# Widgets (al crear el widget). La Site Key va en el frontend.
# Si la dejas vacía, el backend OMITE la verificación (modo demo SENA).
TURNSTILE_SECRET_KEY=0x4AAAAAAA0000000000000_yourSecretKey